# Brewfile — edit this list for the machine you want.
# Re-run `./bootstrap.sh packages` after changing it.
# Formulae always install when INSTALL_PACKAGES=true.
# Casks (apps + fonts) install when INSTALL_CASKS=true.

# Tappie is a Homebrew GUI. Homebrew 6 will not load this third-party cask
# until it is trusted; trust only tappie, not the rest of the tap.
