# Interactive zsh. Copied to ~/.config/mac-forge/dotfiles/zshrc and sourced from ~/.zshrc.

# --- history --------------------------------------------------------------
HISTFILE="${HOME}/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_VERIFY SHARE_HISTORY EXTENDED_HISTORY

# --- completion & editing -------------------------------------------------
autoload -Uz compinit
compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# --- stderr ---------------------------------------------------------------
# Color the interactive shell's fd 2. stdout is unchanged.
if [[ -o interactive && -t 2 && -w /dev/tty ]]; then
  () {
    setopt local_options no_monitor
    exec 2> >(
      while IFS= read -r line || [[ -n $line ]]; do
        printf '\e[31m%s\e[0m\n' "$line"
      done >/dev/tty
    )
  }
fi

# --- editor & pager -------------------------------------------------------
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
else
  export EDITOR=nano
fi
export VISUAL="$EDITOR"
export PAGER="${PAGER:-less}"

# --- aliases --------------------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias g='git'

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='ls -l --git'
  alias la='ls -la --git'
  alias lt='ls --tree --level=2'
else
  alias ll='ls -l'
  alias la='ls -la'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi

if command -v rg >/dev/null 2>&1; then
  alias grep='rg'
fi

# --- tools ----------------------------------------------------------------
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi

if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
  eval "$(pyenv init - zsh)"
  export PIPENV_PYTHON="${PYENV_ROOT}/shims/python"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Local overrides that are not in this repo
[[ -f "${HOME}/.zshrc.local" ]] && source "${HOME}/.zshrc.local"
