# ~/.zprofile — login shell. Keep PATH setup here, interactive config in ~/.zshrc.

# Homebrew (Apple Silicon first, then Intel)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1

# Prefer Homebrew GNU tools when they are installed (coreutils, gnu-sed, grep, findutils)
if command -v brew >/dev/null 2>&1; then
  prefix="$(brew --prefix)"
  for gnubin in coreutils gnu-sed grep findutils gawk; do
    if [[ -d "$prefix/opt/$gnubin/libexec/gnubin" ]]; then
      export PATH="$prefix/opt/$gnubin/libexec/gnubin:$PATH"
    fi
  done
fi

export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

if command -v pyenv >/dev/null 2>&1; then
  export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
  eval "$(pyenv init --path)"
fi
